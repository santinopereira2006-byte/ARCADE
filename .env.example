# ARCADE Tournament Server Configuration

# Port to serve the application and API
PORT=8080

# MongoDB Connection String:
# For local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/arcade_tournament

# For MongoDB Atlas (Cloud - Recommended for Multi-Device Tournaments):
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/arcade_tournament?retryWrites=true&w=majority

# Organizer Admin Passphrase
ADMIN_PASSPHRASE=CSI2026
